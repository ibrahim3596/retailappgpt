# RetailPOS Android build configuration (read by the Secrets Gradle Plugin).
# Copy to `.env` and fill in real values. Never commit `.env`.
# These are client-side configuration values, NOT secrets: they are safe to
# embed in an Android app provided Supabase Row Level Security is enabled.

# Supabase project URL (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=https://placeholder.supabase.co

# Supabase anon/public API key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# Google AI Studio API key used for on-device Gemini fallback features
GEMINI_API_KEY=AIzaSyPlaceholderKeyForTestingOnly