# RetailPOS server configuration. Copy to `.env` (git-ignored) and fill in.

# PostgreSQL connection string used by Prisma
DATABASE_URL=

# JWT signing secret. REQUIRED — the server refuses to start without it.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Port the HTTP server listens on (default 4000)
PORT=4000

# Optional: comma-separated browser origins allowed by CORS, e.g.
# https://dashboard.example.com,https://admin.example.com
# Leave empty when only mobile apps talk to this server.
CORS_ORIGINS=
